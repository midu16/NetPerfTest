# CNF-20409 - Perf Tool Container
# Fedora-based OCI image with perf for performance analysis

FROM registry.fedoraproject.org/fedora:latest

LABEL maintainer="Mihai IDU <midu@redhat.com>" \
      description="Fedora-based container with perf for network testing" \
      version="1.0"

# Install perf and dependencies
RUN dnf install -y \
    perf \
    kernel-tools \
    procps-ng \
    util-linux \
    && dnf clean all

# Set working directory
WORKDIR /data

# Keep container running
CMD ["sleep", "infinity"]

